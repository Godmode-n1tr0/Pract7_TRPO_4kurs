<Page x:Class="pract7.Pages.EditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Данные лекарства">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" Padding="12" Margin="0,16,0,0">
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <Grid IsEnabled="{Binding CanWork}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Content="Назад к каталогу" Click="Back_Click"
                    HorizontalAlignment="Left" Margin="0,0,0,20"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="650" Margin="8" HorizontalAlignment="Stretch">
                    <TextBlock Text="Данные лекарства" FontSize="26" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding CurrentId, StringFormat=Id записи: {0}}" Margin="0,0,0,12"/>
                    <TextBlock Text="Для частичного изменения отметьте нужные поля. При полном изменении сохраняются все поля."
                               TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <CheckBox Content="Название" IsChecked="{Binding UseName}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
                    <CheckBox Content="Производитель" IsChecked="{Binding UseManufacturer}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding ManufacturerText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
                    <CheckBox Content="Цена" IsChecked="{Binding UsePrice}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
                    <CheckBox Content="Срок годности — ГГГГ-ММ-ДД" IsChecked="{Binding UseDate}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
                    <CheckBox Content="Изменить наличие при PATCH" IsChecked="{Binding UseAvailable}" Margin="0,0,0,12"/>
                    <CheckBox Content="Есть в наличии" IsChecked="{Binding Available}" Margin="0,0,0,24"/>
                    <WrapPanel>
                        <Button Content="Изменить полностью" Click="Put_Click" Margin="0,0,12,12"/>
                        <Button Content="Изменить частично" Click="Patch_Click" Margin="0,0,12,12"/>
                        <Button Content="Удалить" Click="Delete_Click" Margin="0,0,12,12"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Page>
