<Page x:Class="pract7.Pages.AddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление лекарства">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" Padding="12" Margin="0,16,0,0">
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <Grid IsEnabled="{Binding CanWork}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Content="Назад к каталогу" Click="Back_Click"
                    HorizontalAlignment="Left" Margin="0,0,0,20"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="600" Margin="8" HorizontalAlignment="Stretch">
                    <TextBlock Text="Добавление лекарства" FontSize="26" Margin="0,0,0,20"/>
                    <TextBlock Text="Название" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
                    <TextBlock Text="Производитель" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding ManufacturerText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
                    <TextBlock Text="Цена" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
                    <TextBlock Text="Срок годности — ГГГГ-ММ-ДД" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
                    <CheckBox Content="Есть в наличии" IsChecked="{Binding Available}" Margin="0,0,0,24"/>
                    <WrapPanel>
                        <Button Content="Добавить" Click="Create_Click" Margin="0,0,12,12"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Page>
