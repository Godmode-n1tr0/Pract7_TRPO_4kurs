<Page x:Class="pract7.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Каталог" Loaded="MainPage_Loaded">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" Padding="12" Margin="0,16,0,0">
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <Grid IsEnabled="{Binding CanWork}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Каталог лекарств" FontSize="26" Margin="0,0,0,24"/>
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Адрес API" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Обновить список" Click="Refresh_Click" Margin="16,0,0,0"/>
            </Grid>
            <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBox Width="260" Margin="0,0,16,12"
                         Text="{Binding ManufacturerFilter, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Производитель" VerticalAlignment="Center"/>
                <ComboBox Width="180" Margin="0,0,16,12"
                          ItemsSource="{Binding AvailabilityOptions}"
                          SelectedIndex="{Binding FilterIndex}"/>
                <Button Content="Найти" Click="Refresh_Click" Margin="0,0,12,12"/>
                <Button Content="Сбросить" Click="ResetFilters_Click" Margin="0,0,0,12"/>
            </WrapPanel>
            <DataGrid Grid.Row="3" ItemsSource="{Binding Medicines}"
                      SelectedItem="{Binding SelectedMedicine, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="180"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="100"/>
                    <DataGridTextColumn Header="Срок годности" Binding="{Binding ExpirationDate, StringFormat={}{0:yyyy-MM-dd}}" Width="140"/>
                    <DataGridCheckBoxColumn Header="Наличие" Binding="{Binding IsAvailable}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Grid.Row="4" Margin="0,20,0,0">
                <Button Content="Открыть выбранное" Click="Open_Click" Margin="0,0,16,8"/>
                <Button Content="Добавить лекарство" Click="New_Click" Margin="0,0,0,8"/>
            </WrapPanel>
        </Grid>
    </DockPanel>
</Page>
