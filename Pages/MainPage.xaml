<Page x:Class="pract7.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Лекарства" Background="White">
    <DockPanel Margin="10" IsEnabled="{Binding CanWork}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Адрес API"/>
            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,10">
                <StackPanel Width="230" Margin="0,0,10,0">
                    <TextBlock Text="Производитель"/>
                    <TextBox Text="{Binding ManufacturerFilter, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Width="110" Margin="0,0,10,0">
                    <TextBlock Text="Наличие"/>
                    <ComboBox ItemsSource="{Binding AvailabilityOptions}" SelectedIndex="{Binding FilterIndex}"/>
                </StackPanel>
                <Button Content="Показать" Click="Refresh_Click" VerticalAlignment="Bottom"/>
            </WrapPanel>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Добавить" Click="New_Click" Margin="0,0,10,0"/>
            <Button Content="Открыть" Click="Open_Click"/>
        </WrapPanel>
        <DataGrid ItemsSource="{Binding Medicines}" SelectedItem="{Binding SelectedMedicine, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="*" MinWidth="140"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="90"/>
                <DataGridTextColumn Header="Срок годности" Binding="{Binding ExpirationDate, StringFormat={}{0:yyyy-MM-dd}}" Width="130"/>
                <DataGridCheckBoxColumn Header="Наличие" Binding="{Binding IsAvailable}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>
